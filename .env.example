# 环境变量配置示例
# 将此文件复制为 .env 并填入实际值
# 警告：.env 文件包含密钥，绝对不要提交到版本控制

# ── 数据库 ────────────────────────────────────────────────────────────────
# PostgreSQL 连接串
DATABASE_URL=postgresql+psycopg://postgres:yourpassword@127.0.0.1:5432/jarvis

# ── 服务器 ────────────────────────────────────────────────────────────────
JARVIS_SERVER_HOST=127.0.0.1
JARVIS_SERVER_PORT=8001

# ── 知识库 ────────────────────────────────────────────────────────────────
# 本地知识库根目录（绝对路径）
JARVIS_KNOWLEDGE_ROOT=C:\Users\YourName\Documents\KnowledgeBase

# ── Kimi（Moonshot AI）────────────────────────────────────────────────────
# 从 https://platform.moonshot.cn/ 获取 API Key
KIMI_API_KEY=your-kimi-api-key-here
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.5
KIMI_TIMEOUT_SECONDS=60
# 可选：覆盖内置系统 Prompt（留空则使用内置默认值）
KIMI_SYSTEM_PROMPT=

# ── 阿里云 DashScope（语音）──────────────────────────────────────────────
# 从 https://dashscope.console.aliyun.com/ 获取 API Key
ALIYUN_DASHSCOPE_API_KEY=your-dashscope-api-key-here
ALIYUN_ASR_MODEL=paraformer-realtime-v2
ALIYUN_TTS_MODEL=cosyvoice-v1
# 可选音色：longxiaochun / longxiaobai / longwan / longcheng / longhua
ALIYUN_TTS_VOICE=longxiaochun
ALIYUN_SPEECH_LANGUAGE=zh-CN
